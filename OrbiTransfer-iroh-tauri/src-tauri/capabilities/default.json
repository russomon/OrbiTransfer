{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for OrbiTransfer transfer windows (main + per-session windows)",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "dialog:default",
    "os:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/orbitransfer-iroh-cli",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write"
  ]
}
