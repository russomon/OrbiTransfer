{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbiTransfer",
  "version": "0.2.0",
  "identifier": "com.orbitolive.orbitransfer.tauri",
  "build": {
    "beforeDevCommand": "npm run sync:cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sync:cli && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OrbiTransfer",
        "width": 900,
        "height": 580,
        "minWidth": 680,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/orbitransfer-iroh-cli"],
    "category": "Productivity",
    "shortDescription": "Peer-to-peer file transfer over Iroh.",
    "longDescription": "OrbiTransfer sends files directly between devices using Iroh, QUIC, and BLAKE3 verified streaming. No accounts, no intermediary cloud storage.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
